# ---------------------------------------------------------------------------
# UI 子目录 .gitignore（与根目录规则互补，便于单独拷贝 UI 目录）
# ---------------------------------------------------------------------------
.venv/
.uv-cache/
__pycache__/
*.py[cod]
projects/
output/
logs/
temp/
*.log
.DS_Store

# 运行时生成的用户设置（程序目录等），不入库
settings.json
